---
// Polices servies par le site lui-même (et non par Google Fonts) : aucune donnée envoyée à Google
import '@fontsource/luckiest-guy/latin-400.css';
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-700.css';
import '@fontsource/nunito/latin-700-italic.css';
import '@fontsource/nunito/latin-800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';

interface Props {
	titre?: string;
	description?: string;
}

const { titre, description = `${site.nom} : ${site.accroche}. ${site.devise} Jeux de société, figurines, ateliers, tournois, café et gourmandises.` } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={url('favicon.png')} />
		<link rel="apple-touch-icon" href={url('favicon.png')} />
		<meta name="generator" content={Astro.generator} />
		<title>{titre ? `${titre} · ${site.nom}` : site.nom}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
