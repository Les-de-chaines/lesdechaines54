---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';

interface Props {
	titre?: string;
	description?: string;
}

const { titre, description = `${site.nom} : ${site.accroche}. ${site.devise} Jeux de société, figurines, ateliers, tournois, café et gourmandises.` } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={url('favicon.png')} />
		<link rel="apple-touch-icon" href={url('favicon.png')} />
		<meta name="generator" content={Astro.generator} />
		<title>{titre ? `${titre} · ${site.nom}` : site.nom}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Nunito:wght@400;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
