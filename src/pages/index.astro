---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo.png';
import Carrousel from '../components/Carrousel.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';
---

<Layout>
	<section class="hero">
		<div class="conteneur hero-contenu">
			<Image src={logo} alt={`Logo ${site.nom}`} width={420} height={420} loading="eager" class="hero-logo" />
			<div>
				<h1>Bienvenue chez <span class="nom">{site.nom}&nbsp;!</span></h1>
				<p class="intro">
					Ici, les dés roulent, les armées s'affrontent et les fous rires fusent.
				</p>
				<p class="intro">Au programme&nbsp;: <strong>jeux de société</strong>, <strong>figurines</strong>, <strong>ateliers</strong> et <strong>tournois</strong>.
				</p>
				<p class="intro">Et parce qu'aucun aventurier ne part le ventre vide, le ravitaillement est assuré à prix doux&nbsp;: boissons
					chaudes, rafraîchissements et gourmandises maison.
				</p>
				<p class="intro">Novice ou vétéran couvert de cicatrices, en solo ou en compagnie&nbsp;: déchaînez l'aventurier qui sommeille en vous&nbsp;!</p>
				<p class="actions">
					<a href={url('evenements/')} class="bouton">Voir les événements</a>
					<a href={url('infos/')} class="lien">Infos pratiques →</a>
				</p>
			</div>
		</div>
	</section>

	<Carrousel />

	<section class="section">
		<div class="conteneur">
			<h2>Choisissez votre quête</h2>
			<div class="grille">
				<article class="carte">
					<h3>🎲 Jeux de société</h3>
					<p>
						Une ludothèque qui ne demande qu'à être pillée&nbsp;: jeux en famille, d'ambiance ou de stratégie pour
						cerveaux musclés. Les règles&nbsp;? On vous les explique, sans jet de sauvegarde.
					</p>
				</article>
				<article class="carte">
					<h3>⚔️ Figurines</h3>
					<p>
						Des champs de bataille à conquérir et des pinceaux à dompter&nbsp;: parties, tournois et ateliers peinture,
						de la première sous-couche au chef-d'œuvre.
					</p>
				</article>
				<article class="carte">
					<h3>☕ La taverne</h3>
					<p>
						Toute aventure commence à la taverne&nbsp;: un comptoir pour souffler, papoter et regagner quelques points
						de vie entre deux parties.
					</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section bandeau">
		<div class="conteneur">
			<h2>Prochaines aventures</h2>
			<p>Le tableau des quêtes se remplit bientôt. En attendant, lustrez vos dés et préparez vos pinceaux&nbsp;!</p>
			<a href={url('evenements/')} class="bouton">Tous les événements</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-block: 2.5rem;
	}

	.hero-contenu {
		display: grid;
		gap: 2rem;
		align-items: center;
		grid-template-columns: minmax(0, 1fr);
	}

	@media (min-width: 48rem) {
		.hero-contenu {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		}
	}

	.hero-logo {
		width: 100%;
		max-width: 12rem;
		margin-inline: auto;
		display: block;
	}

	@media (min-width: 48rem) {
		.hero-logo {
			max-width: 26rem;
		}
	}

	.nom {
		white-space: nowrap;
	}

	.intro {
		font-size: 1.1rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.5rem;
	}

	.lien {
		font-weight: 800;
	}

	.bandeau {
		background: var(--vert-clair);
		border-block: 3px solid var(--brun);
	}
</style>
