---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../lib/site';
import Reseaux from '../../components/Reseaux.astro';
---

<Layout titre="Événements" description={`Soirées jeux, tournois et ateliers figurines organisés par ${site.nom}.`}>
	<div class="conteneur section">
		<h1>Événements</h1>
		<p>Soirées jeux, tournois, ateliers peinture… Retrouvez ici tous nos prochains rendez-vous.</p>

		<div class="carte">
			<p>Aucun événement pour le moment. Revenez bientôt&nbsp;!</p>
			<p>
				Pour être prévenu dès qu'une date tombe, suivez-nous sur les réseaux&nbsp;: c'est là que nous annonçons
				tous nos rendez-vous en premier.
			</p>
			<Reseaux />
		</div>
	</div>
</Layout>
