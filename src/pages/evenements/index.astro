---
import Layout from '../../layouts/Layout.astro';
import CarrouselAffiches from '../../components/CarrouselAffiches.astro';
import { site } from '../../lib/site';
---

<Layout titre="Événements" description={`Soirées jeux, tournois et ateliers figurines organisés par ${site.nom}.`}>
	<div class="conteneur section">
		<h1>Événements</h1>
		<p>Soirées jeux, tournois, ateliers peinture… Retrouvez ici tous nos prochains rendez-vous.</p>

		<CarrouselAffiches />

		<div class="carte">
			<p>
				Pour être prévenu dès qu'une date tombe, suivez-nous sur{' '}
				<a href={site.reseaux.facebook} target="_blank" rel="noopener">Facebook</a>{' '}
				et <a href={site.reseaux.instagram} target="_blank" rel="noopener">Instagram</a>&nbsp;: c'est là que nous
				annonçons tous nos rendez-vous en premier.
			</p>
		</div>
	</div>
</Layout>
