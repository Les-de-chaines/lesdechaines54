---
import Layout from '../layouts/Layout.astro';
import Embleme from '../components/Embleme.astro';
import Reseaux from '../components/Reseaux.astro';
import { site } from '../lib/site';
import { Image } from 'astro:assets';
import plan from '../assets/plan.png';
import { url } from '../lib/url';

const { rue, codePostal, ville } = site.adresse;
const adresse = encodeURIComponent(`${rue}, ${codePostal} ${ville}`);
const lienCarte = `https://www.google.com/maps/search/?api=1&query=${adresse}`;

// Moyens d'accès : `aVerifier` surligne en jaune les infos à confirmer avant publication
const acces = [
	{ mode: 'En voiture', texte: 'A31, sortie 24 « Custines »' },
	{
		mode: 'En bus',
		sousListe: [
			'Depuis Nancy, ligne SUB 10, arrêt « Parc Eiffel », puis 15 min à pied',
			'Le Sit ligne 34, arrêt « René II », à 100 m (sur réservation en journée)',
		],
	},
	{ mode: 'En train', texte: 'gare de Pompey, à 2 km, puis VéloMoove ou ligne 34' },
	{
		mode: 'À vélo',
		texte: 'VéloMoove en libre-service, station « Guingot » à 200 m',
		lien: 'https://velomoove.bassinpompey.fr/fr/map',
	},
];

// Grille tarifaire : adhésions annuelles, puis entrée à la journée pour les non-adhérents
const adhesions = [
	{ formule: 'Adhésion adulte', detail: '18 ans et plus', prix: '25 €' },
	{
		formule: 'Adhésion réduite et solidaire',
		detail:
			'Moins de 18 ans, étudiants, bénéficiaires de minima sociaux, ou si vous estimez ne pas avoir les moyens de payer 25 €',
		prix: '15 €',
	},
	{ formule: 'Adhésion familiale', detail: 'Un ou deux adultes et les enfants mineurs qu\'ils accompagnent', prix: '50 €' },
	{
		formule: 'Adhésion de soutien',
		detail: 'Si vous en avez les moyens et souhaitez nous donner un coup de pouce',
		prix: '50 €',
	},
];

const visiteurs = [
	{ formule: 'Individuel', prix: '3 € / jour' },
	{ formule: 'Famille', prix: '10 € / jour' },
];
---

<Layout titre="Infos pratiques" description={`Adresse, adhésion et contact de l'association ${site.nom} à ${ville}.`}>
	<div class="conteneur section">
		<h1>Infos pratiques</h1>


		<div class="acces">
			<section class="carte">
				<h2 class="titre-embleme"><Embleme />{site.nom}</h2>
				<p>
					{rue}<br />
					{codePostal} {ville}<br />
					<a href={lienCarte} target="_blank" rel="noopener">Voir sur Google Maps ↗</a>
				</p>
				<p>
					<a href={`mailto:${site.email}`}>{site.email}</a><br />
					<a href={`tel:${site.telephone.replace(/[^\d+]/g, '')}`}>{site.telephone}</a>
				</p>
				<p>Vous pouvez aussi nous écrire en message privé&nbsp;:</p>
				<Reseaux variante="discret" />

				<h3>Horaires</h3>
				<p>
					Pas d'horaires fixes&nbsp;: la taverne ouvre ses portes lors de nos événements. Les dates et horaires sont
					annoncés dans le calendrier et sur nos réseaux sociaux.
				</p>
				<p><a href={url('evenements/')}>Voir le calendrier →</a></p>

				<h3>Venir</h3>
				<ul class="moyens">
					{
						acces.map(({ mode, texte, sousListe, aVerifier, lien }) => (
							<li>
								<strong>{mode}&nbsp;:</strong>{' '}
								{sousListe ? (
									<ul class="sous-liste">
										{sousListe.map((element) => <li>{element}</li>)}
									</ul>
								) : (
									<span class={aVerifier ? 'a-completer' : undefined}>
										{lien ? <a href={lien} target="_blank" rel="noopener">{texte}&nbsp;↗</a> : texte}
									</span>
								)}
							</li>
						))
					}
				</ul>
			</section>
			<div class="colonne">
				<a href={lienCarte} class="carte plan" target="_blank" rel="noopener">
					<Image
						src={plan}
						alt={`Plan d'accès : ${rue}, ${codePostal} ${ville}`}
						widths={[640, 960, 1280, 1600]}
						sizes="(min-width: 70rem) 45rem, 100vw"
					/>
				</a>

			<section class="carte adhesion">
				<h2 class="titre-embleme"><Embleme />Adhésion</h2>
				<p>
					L'adhésion permet de soutenir l'association et de participer à toutes ses activités pendant un an.
				</p>
				<table>
					<caption>Adhésions annuelles</caption>
					<tbody>
						{
							adhesions.map(({ formule, detail, prix }) => (
								<tr>
									<th scope="row">
										{formule}
										<span class="detail">{detail}</span>
									</th>
									<td>{prix}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<table>
					<caption>Visiteurs non adhérents</caption>
					<tbody>
						{
							visiteurs.map(({ formule, prix }) => (
								<tr>
									<th scope="row">{formule}</th>
									<td>{prix}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p class="a-completer">[Le bouton d'adhésion HelloAsso sera ajouté ici.]</p>
			</section>
			</div>
		</div>
	</div>
</Layout>

<style>
	/* Adresse à côté du plan sur grand écran, au-dessus sur mobile */
	/* Infos à gauche ; plan et adhésion empilés à droite. Tout l'un sous l'autre sur mobile */
	.acces {
		display: grid;
		gap: 1.5rem;
		align-items: start;
		margin-bottom: 3rem;
	}

	@media (min-width: 48rem) {
		.acces {
			grid-template-columns: minmax(16rem, 1fr) 2fr;
		}
	}

	/* Capture d'écran de Google Maps : aucun cookie ni appel à Google tant qu'on ne clique pas.
	   Le logo Google et les mentions en bas de l'image doivent rester visibles (conditions de Google). */
	.plan {
		display: block;
		padding: 0;
		overflow: hidden;
	}

	.plan img {
		display: block;
		width: 100%;
		height: auto;
	}

	.acces h3 {
		margin: 1.5rem 0 0.5rem;
	}

	.acces p {
		margin: 0 0 0.75rem;
	}

	.moyens {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.moyens li {
		margin-bottom: 0.5rem;
	}

	/* Plusieurs options pour un même moyen de transport (ex. les lignes de bus) */
	.sous-liste {
		margin: 0.25rem 0 0;
		padding-left: 1.2rem;
	}

	.sous-liste li {
		margin-bottom: 0.25rem;
	}

	.colonne {
		display: grid;
		gap: 1.5rem;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 1.5rem;
	}

	caption {
		text-align: left;
		font-family: var(--font-titre);
		font-size: 1.15rem;
		letter-spacing: 0.02em;
		margin-bottom: 0.25rem;
	}

	.detail {
		display: block;
		font-size: 0.85rem;
		font-weight: 400;
		font-style: italic;
		opacity: 0.8;
	}

	th,
	td {
		padding: 0.6rem 0;
		border-bottom: 2px dashed var(--vert);
	}

	th {
		text-align: left;
		font-weight: 700;
	}

	/* Prix aligné sur le nom de la formule, pas au milieu de sa description */
	td {
		vertical-align: top;
		text-align: right;
		font-weight: 800;
		white-space: nowrap;
		padding-left: 1rem;
	}
</style>
