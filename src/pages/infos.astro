---
import Layout from '../layouts/Layout.astro';
import Embleme from '../components/Embleme.astro';
import Reseaux from '../components/Reseaux.astro';
import { site } from '../lib/site';
import { Image } from 'astro:assets';
import plan from '../assets/plan.png';
import { url } from '../lib/url';

const { rue, codePostal, ville } = site.adresse;
const adresse = encodeURIComponent(`${rue}, ${codePostal} ${ville}`);
const lienCarte = `https://www.google.com/maps/search/?api=1&query=${adresse}`;

// Moyens d'accès : `aVerifier` surligne en jaune les infos à confirmer avant publication
const acces = [
	{ mode: 'En voiture', texte: 'A31, sortie 24 « Custines »' },
	{
		mode: 'En bus',
		sousListe: [
			'Depuis Nancy, ligne SUB 10, arrêt « Parc Eiffel », puis 15 min à pied',
			'Le Sit ligne 34, arrêt « René II », à 100 m (sur réservation en journée)',
		],
	},
	{ mode: 'En train', texte: 'gare de Pompey, à 2 km, puis VéloMoove ou ligne 34' },
	{
		mode: 'À vélo',
		texte: 'VéloMoove en libre-service, station « Guingot » à 200 m',
		lien: 'https://velomoove.bassinpompey.fr/fr/map',
	},
];

// Grille tarifaire : adhésions annuelles, puis entrée à la journée pour les non-adhérents
const adhesions = [
	{ formule: 'Adhésion adulte', detail: '18 ans et plus', prix: '25 €' },
	{
		formule: 'Adhésion réduite et solidaire',
		detail:
			'Moins de 18 ans, étudiants, bénéficiaires de minima sociaux, ou si vous estimez ne pas avoir les moyens de payer 25 €',
		prix: '15 €',
	},
	{ formule: 'Adhésion familiale', detail: 'Un ou deux adultes et les enfants mineurs qu\'ils accompagnent', prix: '50 €' },
	{
		formule: 'Adhésion de soutien',
		detail: 'Si vous en avez les moyens et souhaitez nous donner un coup de pouce',
		prix: '50 €',
	},
];

const visiteurs = [
	{ formule: 'Individuel', prix: '3 € / jour' },
	{ formule: 'Famille', prix: '10 € / jour' },
];
---

<Layout titre="Infos pratiques" description={`Adresse, adhésion et contact de l'association ${site.nom} à ${ville}.`}>
	<div class="conteneur section">
		<h1>Infos pratiques</h1>


		<div class="acces">
			<section class="carte coordonnees">
				<details class="repli" data-ouvert-mobile open>
				<summary><h2 class="titre-embleme"><Embleme />{site.nom}</h2></summary>
				<p>
					{rue}<br />
					{codePostal} {ville}<br />
					<a href={lienCarte} target="_blank" rel="noopener">Voir sur Google Maps ↗</a>
				</p>
				<p>
					{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span class="bientot">E-mail bientôt disponible</span>}<br />
					{
						site.telephone ? (
							<a href={`tel:${site.telephone.replace(/[^\d+]/g, '')}`}>{site.telephone}</a>
						) : (
							<span class="bientot">Téléphone bientôt disponible</span>
						)
					}
				</p>
				<p>Vous pouvez aussi nous écrire en message privé&nbsp;:</p>
				<Reseaux variante="discret" />
				</details>
			</section>

			<section class="carte visite">
				<details class="repli" open>
				<summary><h2 class="titre-embleme"><Embleme />Nous rendre visite</h2></summary>
				<h3>Horaires</h3>
				<p>
					Pas d'horaires fixes&nbsp;: la taverne ouvre ses portes lors de nos événements. Les dates et horaires sont
					annoncés dans le calendrier et sur nos réseaux sociaux.
				</p>
				<p><a href={url('evenements/')}>Voir le calendrier →</a></p>

				<h3>Venir</h3>
				<ul class="moyens">
					{
						acces.map(({ mode, texte, sousListe, aVerifier, lien }) => (
							<li>
								<strong>{mode}&nbsp;:</strong>{' '}
								{sousListe ? (
									<ul class="sous-liste">
										{sousListe.map((element) => <li>{element}</li>)}
									</ul>
								) : (
									<span class={aVerifier ? 'a-completer' : undefined}>
										{lien ? <a href={lien} target="_blank" rel="noopener">{texte}&nbsp;↗</a> : texte}
									</span>
								)}
							</li>
						))
					}
				</ul>
				</details>
			</section>

			<a href={lienCarte} class="carte plan" target="_blank" rel="noopener">
					<Image
						src={plan}
						alt={`Plan d'accès : ${rue}, ${codePostal} ${ville}`}
						widths={[640, 960, 1280, 1600]}
						sizes="(min-width: 70rem) 45rem, 100vw"
					/>
				</a>

			<section class="carte adhesion">
				<details class="repli" open>
				<summary><h2 class="titre-embleme"><Embleme />Adhésion</h2></summary>
				<p>
					L'adhésion permet de soutenir l'association et de participer à toutes ses activités pendant un an.
				</p>
				<table>
					<caption>Adhésions annuelles</caption>
					<tbody>
						{
							adhesions.map(({ formule, detail, prix }) => (
								<tr>
									<th scope="row">
										{formule}
										<span class="detail">{detail}</span>
									</th>
									<td>{prix}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<table>
					<caption>Visiteurs non adhérents</caption>
					<tbody>
						{
							visiteurs.map(({ formule, prix }) => (
								<tr>
									<th scope="row">{formule}</th>
									<td>{prix}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				{
					site.helloasso ? (
						<p><a href={site.helloasso} class="bouton" target="_blank" rel="noopener">Adhérer en ligne</a></p>
					) : (
						<p class="bientot">Adhésion en ligne bientôt disponible</p>
					)
				}
				</details>
			</section>
		</div>

		<!-- Mobile : sections repliées, sauf celles marquées data-ouvert-mobile (les coordonnées) ; grand écran : toujours ouvertes (la grille garde ses hauteurs alignées).
		     Script inline et synchrone, pour replier avant le premier affichage ; sans JS, tout reste ouvert. -->
		<script is:inline>
			(() => {
				const grandEcran = matchMedia('(min-width: 48rem)');
				const replis = document.querySelectorAll('.repli');
				const appliquer = () => {
					replis.forEach((repli) => {
						repli.open = grandEcran.matches || 'ouvertMobile' in repli.dataset;
						repli.querySelector('summary').tabIndex = grandEcran.matches ? -1 : 0;
					});
				};
				replis.forEach((repli) =>
					repli.querySelector('summary').addEventListener('click', (e) => {
						if (grandEcran.matches) e.preventDefault();
					}),
				);
				appliquer();
				grandEcran.addEventListener('change', appliquer);
			})();
		</script>
	</div>
</Layout>

<style>
	/* Grand écran : grille 2 × 2, coordonnées | plan, puis visite | adhésion.
	   Les encadrés d'une même ligne ont la même hauteur, donc ils sont alignés en haut et en bas.
	   Mobile : tout l'un sous l'autre, dans l'ordre du code (coordonnées, visite, plan, adhésion). */
	.acces {
		display: grid;
		gap: 1.5rem;
		margin-bottom: 3rem;
	}

	@media (min-width: 48rem) {
		.acces {
			grid-template-columns: minmax(min-content, 1fr) 2fr;
			grid-template-areas:
				'coordonnees plan'
				'visite adhesion';
		}

		.coordonnees {
			grid-area: coordonnees;
		}

		.plan {
			grid-area: plan;
		}

		.visite {
			grid-area: visite;
		}

		.adhesion {
			grid-area: adhesion;
		}

		/* Titres des cartes sur une seule ligne : la première colonne s'élargit d'autant */
		.acces h2 {
			white-space: nowrap;
		}

		/* Le plan remplit toute la hauteur de sa ligne ; s'il doit être rogné, on garde le bas
		   (logo et mentions Google obligatoires) */
		.acces .plan img {
			height: 100%;
			object-fit: cover;
			object-position: bottom;
		}
	}

	/* Capture d'écran de Google Maps : aucun cookie ni appel à Google tant qu'on ne clique pas.
	   Le logo Google et les mentions en bas de l'image doivent rester visibles (conditions de Google). */
	.plan {
		display: block;
		padding: 0;
		overflow: hidden;
	}

	.plan img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Sections repliables (mobile) : le titre de la carte sert de bouton */
	.repli > summary {
		list-style: none;
		position: relative;
	}

	.repli > summary::-webkit-details-marker {
		display: none;
	}

	.repli:not([open]) h2 {
		margin-bottom: 0;
	}

	@media (max-width: 47.99rem) {
		.repli > summary {
			cursor: pointer;
			padding-inline: 2rem;
		}

		/* Chevron à droite du titre, pointe vers le bas quand c'est replié */
		.repli > summary::after {
			content: '';
			position: absolute;
			right: 0.25rem;
			top: 50%;
			width: 0.7rem;
			height: 0.7rem;
			border-right: 3px solid var(--rose);
			border-bottom: 3px solid var(--rose);
			transform: translateY(-75%) rotate(45deg);
			transition: transform 0.2s;
		}

		.repli[open] > summary::after {
			transform: translateY(-25%) rotate(-135deg);
		}

		.repli > summary:focus-visible {
			outline: 3px solid var(--rose);
			outline-offset: 0.25rem;
			border-radius: 0.5rem;
		}
	}

	/* Intertitres des cartes (« Horaires », « Venir », titres des tableaux) : même style partout */
	.acces h3,
	.acces caption {
		font-family: var(--font-titre);
		font-size: 1.35rem;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-align: left;
		margin: 0 0 0.5rem;
	}

	.acces h3 {
		margin-top: 1.5rem;
	}

	/* Pas d'espace en trop juste sous le titre de la carte */
	.acces summary + h3 {
		margin-top: 0.5rem;
	}

	.acces p {
		margin: 0 0 0.75rem;
	}

	.moyens {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.moyens li {
		margin-bottom: 0.5rem;
	}

	/* Plusieurs options pour un même moyen de transport (ex. les lignes de bus) */
	.sous-liste {
		margin: 0.25rem 0 0;
		padding-left: 1.2rem;
	}

	.sous-liste li {
		margin-bottom: 0.25rem;
	}

	/* Même espacement au-dessus d'un tableau qu'au-dessus d'un intertitre */
	table {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
	}

	.detail {
		display: block;
		font-size: 0.85rem;
		font-weight: 400;
		font-style: italic;
		opacity: 0.8;
	}

	th,
	td {
		padding: 0.6rem 0;
		border-bottom: 2px dashed var(--vert);
	}

	th {
		text-align: left;
		font-weight: 700;
	}

	/* Prix aligné sur le nom de la formule, pas au milieu de sa description */
	td {
		vertical-align: top;
		text-align: right;
		font-weight: 800;
		white-space: nowrap;
		padding-left: 1rem;
	}
</style>
