---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';

const { rue, codePostal, ville, lat, lon } = site.adresse;
const marge = 0.003;
const carte = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - marge * 2},${lat - marge},${lon + marge * 2},${lat + marge}&layer=mapnik&marker=${lat},${lon}`;
const itineraire = `https://www.openstreetmap.org/directions?to=${lat},${lon}`;

// Tarifs à compléter
const tarifs = [
	{ formule: 'Adhésion individuelle', prix: '[XX €] / an' },
	{ formule: 'Adhésion famille', prix: '[XX €] / an' },
	{ formule: 'Tarif réduit (étudiants, demandeurs d\'emploi)', prix: '[XX €] / an' },
];
---

<Layout titre="Infos pratiques" description={`Adresse, horaires, adhésion et contact de l'association ${site.nom} à ${ville}.`}>
	<div class="conteneur section">
		<h1>Infos pratiques</h1>

		<div class="grille">
			<section class="carte">
				<h2>📍 Adresse</h2>
				<p>
					<strong>{site.nom}</strong><br />
					{rue}<br />
					{codePostal} {ville}
				</p>
				<p><a href={itineraire}>Calculer un itinéraire</a></p>
			</section>

			<section class="carte">
				<h2>🕒 Horaires</h2>
				<ul class="liste">
					<li><span class="a-completer">[Mercredi : 14h – 19h]</span></li>
					<li><span class="a-completer">[Vendredi : 18h – 23h]</span></li>
					<li><span class="a-completer">[Samedi : 14h – 23h]</span></li>
				</ul>
				<p>Horaires des événements : voir le calendrier.</p>
			</section>

			<section class="carte">
				<h2>✉️ Contact</h2>
				<p>
					E-mail : <a href={`mailto:${site.email}`}>{site.email}</a><br />
					Téléphone : {site.telephone}
				</p>
			</section>
		</div>

		<section class="section">
			<h2>Nous trouver</h2>
			<iframe
				class="plan"
				src={carte}
				title={`Plan d'accès : ${rue}, ${codePostal} ${ville}`}
				loading="lazy"></iframe>
		</section>

		<section class="carte adhesion">
			<h2>🎟️ Adhésion</h2>
			<p>
				L'adhésion permet de soutenir l'association et de participer à toutes ses activités pendant un an.
			</p>
			<table>
				<tbody>
					{
						tarifs.map(({ formule, prix }) => (
							<tr>
								<th scope="row">{formule}</th>
								<td>{prix}</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="a-completer">[Le bouton d'adhésion HelloAsso sera ajouté ici.]</p>
		</section>
	</div>
</Layout>

<style>
	.liste {
		padding-left: 1.2rem;
		margin: 0 0 1rem;
	}

	.plan {
		width: 100%;
		height: 24rem;
		border: 3px solid var(--brun);
		border-radius: var(--rayon);
	}

	.adhesion {
		max-width: 40rem;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 1rem;
	}

	th,
	td {
		padding: 0.6rem 0;
		border-bottom: 2px dashed var(--vert);
	}

	th {
		text-align: left;
		font-weight: 700;
	}

	td {
		text-align: right;
		font-weight: 800;
		white-space: nowrap;
		padding-left: 1rem;
	}
</style>
