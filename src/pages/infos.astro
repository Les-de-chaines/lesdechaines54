---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { Image } from 'astro:assets';
import plan from '../assets/plan.png';

const { rue, codePostal, ville } = site.adresse;
const adresse = encodeURIComponent(`${rue}, ${codePostal} ${ville}`);
const itineraire = `https://www.google.com/maps/dir/?api=1&destination=${adresse}`;
const lienCarte = `https://www.google.com/maps/search/?api=1&query=${adresse}`;

// Tarifs à compléter
const tarifs = [
	{ formule: 'Adhésion individuelle', prix: '[XX €] / an' },
	{ formule: 'Adhésion famille', prix: '[XX €] / an' },
	{ formule: 'Tarif réduit (étudiants, demandeurs d\'emploi)', prix: '[XX €] / an' },
];
---

<Layout titre="Infos pratiques" description={`Adresse, horaires, adhésion et contact de l'association ${site.nom} à ${ville}.`}>
	<div class="conteneur section">
		<h1>Infos pratiques</h1>

		<div class="grille">
			<section class="carte">
				<h2>📍 Adresse</h2>
				<p>
					<strong>{site.nom}</strong><br />
					{rue}<br />
					{codePostal} {ville}
				</p>
				<p><a href={itineraire}>Calculer un itinéraire</a></p>
			</section>

			<section class="carte">
				<h2>🕒 Horaires</h2>
				<ul class="liste">
					<li><span class="a-completer">[Mercredi : 14h – 19h]</span></li>
					<li><span class="a-completer">[Vendredi : 18h – 23h]</span></li>
					<li><span class="a-completer">[Samedi : 14h – 23h]</span></li>
				</ul>
				<p>Horaires des événements : voir le calendrier.</p>
			</section>

			<section class="carte">
				<h2>✉️ Contact</h2>
				<p>
					E-mail : <a href={`mailto:${site.email}`}>{site.email}</a><br />
					Téléphone : {site.telephone}
				</p>
			</section>
		</div>

		<section class="section">
			<h2>Nous trouver</h2>
			<a href={lienCarte} class="plan" target="_blank" rel="noopener">
				<Image
					src={plan}
					alt={`Plan d'accès : ${rue}, ${codePostal} ${ville}`}
					widths={[640, 960, 1280, 1600]}
					sizes="(min-width: 70rem) 68rem, 100vw"
				/>
				<span class="bouton">Ouvrir dans Google Maps ↗</span>
			</a>
		</section>

		<section class="carte adhesion">
			<h2>🎟️ Adhésion</h2>
			<p>
				L'adhésion permet de soutenir l'association et de participer à toutes ses activités pendant un an.
			</p>
			<table>
				<tbody>
					{
						tarifs.map(({ formule, prix }) => (
							<tr>
								<th scope="row">{formule}</th>
								<td>{prix}</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="a-completer">[Le bouton d'adhésion HelloAsso sera ajouté ici.]</p>
		</section>
	</div>
</Layout>

<style>
	.liste {
		padding-left: 1.2rem;
		margin: 0 0 1rem;
	}

	/* Capture d'écran de Google Maps : aucun cookie ni appel à Google tant qu'on ne clique pas.
	   Le logo Google et les mentions en bas de l'image doivent rester visibles (conditions de Google). */
	.plan {
		position: relative;
		display: block;
		border: 3px solid var(--brun);
		border-radius: var(--rayon);
		overflow: hidden;
		text-decoration: none;
	}

	.plan img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Sur mobile, le bouton passe sous le plan pour ne pas le masquer */
	.plan .bouton {
		display: block;
		margin: 0.75rem;
		font-size: 1rem;
		text-align: center;
	}

	@media (min-width: 48rem) {
		.plan .bouton {
			position: absolute;
			top: 1rem;
			left: 1rem;
			margin: 0;
		}
	}

	.adhesion {
		max-width: 40rem;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 1rem;
	}

	th,
	td {
		padding: 0.6rem 0;
		border-bottom: 2px dashed var(--vert);
	}

	th {
		text-align: left;
		font-weight: 700;
	}

	td {
		text-align: right;
		font-weight: 800;
		white-space: nowrap;
		padding-left: 1rem;
	}
</style>
