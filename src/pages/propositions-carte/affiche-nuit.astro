---
// Proposition d'affiche n° 1 : « Taverne de nuit », dans la lignée des affiches d'événements
// (fond brun, titres en vert, étiquettes roses inclinées, pied avec adresse et QR code).
import { Image } from 'astro:assets';
import FeuilleA4 from '../../components/FeuilleA4.astro';
import RubriqueCarte from '../../components/RubriqueCarte.astro';
import Embleme from '../../components/Embleme.astro';
import logo from '../../assets/logo.png';
import { carte, mentionsAlcool } from '../../lib/carte';
import { site } from '../../lib/site';
import { qrSvg } from '../../lib/qr';

const qr = await qrSvg(site.reseaux.facebook);
const { rue, codePostal, ville } = site.adresse;
// Deux colonnes équilibrées : boissons chaudes et softs | bières, grignotage, crêpes
const colonnes = [carte.slice(0, 2), carte.slice(2)];
---

<FeuilleA4 titre="Carte · Taverne de nuit" class="nuit">
	<Embleme class="filigrane" />

	<header class="entete">
		<Image src={logo} alt="" width={400} height={400} class="logo" />
		<div>
			<p class="nom-site">{site.nom}</p>
			<p class="accroche-site">{site.accroche}</p>
		</div>
	</header>

	<h1><span class="petit">La carte de la</span> Taverne</h1>

	<div class="colonnes">
		{
			colonnes.map((rubriques) => (
				<div class="colonne">
					{rubriques.map((rubrique) => <RubriqueCarte rubrique={rubrique} />)}
				</div>
			))
		}
	</div>

	<footer class="pied">
		<p>
			<strong>{site.nom}</strong><br />
			{rue}, {codePostal} {ville}<br />
			<span class="mentions">{mentionsAlcool.join(' ')}</span>
		</p>
		<div class="qr">
			<p>Suivez-nous<br />sur Facebook&nbsp;!</p>
			<span class="qr-code" set:html={qr} />
		</div>
	</footer>
</FeuilleA4>

<style>
	:global(.nuit) {
		display: flex;
		flex-direction: column;
		color: var(--creme);
		background: var(--brun);
	}

	:global(.nuit) > :global(.filigrane) {
		position: absolute;
		z-index: -1;
		right: -40mm;
		bottom: 25mm;
		width: 150mm;
		color: var(--creme);
		opacity: 0.08;
	}

	.entete {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 5mm;
		padding: 8mm 14mm 0;
	}

	.logo {
		width: 30mm;
		height: 30mm;
		border-radius: 50%;
		background: var(--creme);
		border: 1mm solid var(--vert);
	}

	.nom-site {
		font-family: var(--font-titre);
		font-size: 12mm;
		line-height: 1;
	}

	.accroche-site {
		font-size: 5.5mm;
		font-weight: 700;
		font-style: italic;
		color: var(--vert);
	}

	h1 {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 4mm 0 0;
		font-size: 20mm;
		line-height: 1;
		color: var(--vert);
		text-align: center;
	}

	.petit {
		font-size: 8mm;
		color: var(--creme);
	}

	.colonnes {
		flex: 1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12mm;
		padding: 6mm 14mm;
	}

	.colonne {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 8mm;
	}

	/* Titre de rubrique : étiquette rose inclinée, comme la pastille des affiches */
	:global(.nuit .titre-rubrique) {
		display: inline-flex;
		align-items: center;
		gap: 2mm;
		margin-bottom: 3mm;
		padding: 2mm 5mm 1mm;
		font-size: 7mm;
		white-space: nowrap;
		color: var(--blanc);
		background: var(--rose);
		border: 0.6mm solid var(--brun);
		border-radius: 999px;
		box-shadow: 1mm 1mm 0 var(--vert);
		transform: rotate(-2deg);
	}

	:global(.nuit .rubrique:nth-child(even) .titre-rubrique) {
		transform: rotate(1.5deg);
	}

	:global(.nuit .icone) {
		font-size: 5.5mm;
		transform: translateY(-0.5mm);
	}

	:global(.nuit .note-rubrique) {
		margin: -1mm 0 2mm;
		font-size: 3.8mm;
		font-style: italic;
		font-weight: 700;
		color: var(--vert);
	}

	/* Ligne d'article : nom, pointillés, prix ; la précision en dessous */
	:global(.nuit .article) {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas:
			'nom points prix'
			'detail detail .';
		align-items: baseline;
		column-gap: 2mm;
		padding-block: 1.3mm;
		font-size: 5.6mm;
		line-height: 1.25;
	}

	:global(.nuit .nom) {
		grid-area: nom;
		font-weight: 800;
	}

	:global(.nuit .format) {
		margin-left: 1.5mm;
		font-size: 3.6mm;
		font-weight: 700;
		opacity: 0.7;
	}

	:global(.nuit .points) {
		grid-area: points;
		border-bottom: 0.6mm dotted rgb(251 246 234 / 0.45);
	}

	:global(.nuit .prix) {
		grid-area: prix;
		font-weight: 800;
		font-size: 5.8mm;
		color: var(--vert);
		white-space: nowrap;
	}

	:global(.nuit .prix.a-completer) {
		color: var(--brun);
	}

	:global(.nuit .detail) {
		grid-area: detail;
		font-size: 3.8mm;
		font-style: italic;
		font-weight: 700;
		opacity: 0.8;
	}

	.pied {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 6mm;
		padding: 5mm 14mm;
		font-size: 4mm;
		line-height: 1.4;
		background: #2a170e;
		border-top: 2mm solid var(--vert);
	}

	.pied strong {
		font-family: var(--font-titre);
		font-weight: 400;
		font-size: 6mm;
		color: var(--vert);
	}

	.mentions {
		display: block;
		margin-top: 1mm;
		font-size: 3.2mm;
		font-style: italic;
		opacity: 0.75;
	}

	.qr {
		display: flex;
		flex: none;
		align-items: center;
		gap: 4mm;
		text-align: right;
		font-weight: 800;
	}

	.qr-code {
		display: block;
		width: 22mm;
		padding: 1.5mm;
		background: var(--creme);
		border-radius: 1.5mm;
	}

	.qr-code :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
