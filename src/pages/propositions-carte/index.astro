---
// Page interne (non liée, non référencée) : les propositions de carte, pour choisir.
// Pour l'instant, la carte n'existe qu'en affiche à imprimer (pas de page sur le site). Les prix se modifient dans src/lib/carte.ts.
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';

const affiches = [
	{ cle: 'affiche-nuit', nom: '1 · Taverne de nuit', texte: 'Fond brun, pastilles roses : la famille des affiches d’événements.' },
	{ cle: 'affiche-parchemin', nom: '2 · Parchemin', texte: 'Une page de grimoire de taverne, encre brune sur parchemin.' },
	{ cle: 'affiche-creme', nom: '3 · Crème', texte: 'Économe en encre : encadrés du site, crêpes à part en bas.' },
];
---

<Layout titre="Propositions de carte" description="Propositions de carte : affiche à imprimer." cachee>
	<div class="conteneur section">
		<h1>Propositions de carte</h1>
		<h2>Affiche à imprimer (A4)</h2>
		<ul class="grille propositions">
			{
				affiches.map(({ cle, nom, texte }) => (
					<li class="carte">
						<a href={url(`propositions-carte/${cle}/`)} class="apercu" tabindex="-1">
							<iframe src={url(`propositions-carte/${cle}/`)} title={`Aperçu : ${nom}`} loading="lazy" tabindex="-1" />
						</a>
						<h3><a href={url(`propositions-carte/${cle}/`)}>{nom}</a></h3>
						<p>{texte}</p>
					</li>
				))
			}
		</ul>
	</div>
</Layout>

<style>
	.propositions {
		list-style: none;
		margin: 0 0 3rem;
		padding: 0;
	}

	.propositions p {
		margin: 0;
	}

	/* Aperçu de l'affiche à l'échelle de la carte ; un clic ouvre l'affiche */
	.apercu {
		position: relative;
		display: block;
		aspect-ratio: 210 / 297;
		margin-bottom: 1rem;
		overflow: hidden;
		border: 2px solid var(--brun);
		border-radius: 0.5rem;
	}

	.apercu iframe {
		width: 100%;
		height: 100%;
		border: 0;
		pointer-events: none;
	}
</style>
