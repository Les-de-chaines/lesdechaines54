---
// Proposition d'affiche n° 3 : « Crème », économe en encre, reprend les cartes du site
// (fond crème, encadrés blancs bordés de brun avec l'ombre verte, titres de rubrique en pastille rose).
// Les crêpes, pas toujours disponibles, ont leur propre bandeau en bas.
import { Image } from 'astro:assets';
import FeuilleA4 from '../../components/FeuilleA4.astro';
import RubriqueCarte from '../../components/RubriqueCarte.astro';
import Embleme from '../../components/Embleme.astro';
import logo from '../../assets/logo.png';
import { carte, mentionsAlcool } from '../../lib/carte';
import { site } from '../../lib/site';
import { qrSvg } from '../../lib/qr';

const qr = await qrSvg(site.reseaux.facebook, '#3e2416', '#ffffff');
const { rue, codePostal, ville } = site.adresse;
const crepes = carte.find(({ titre }) => titre === 'Crêpes');
const rubriques = carte.filter((rubrique) => rubrique !== crepes);
---

<FeuilleA4 titre="Carte · Crème" class="creme">
	<Embleme class="filigrane" />

	<header class="entete">
		<Image src={logo} alt="" width={300} height={300} class="logo" />
		<div>
			<p class="nom-site">{site.nom}</p>
			<p class="accroche-site">{site.accroche}</p>
		</div>
		<h1>La carte</h1>
	</header>

	<div class="grille-carte">
		{
			rubriques.map((rubrique) => (
				<div class="encadre">
					<RubriqueCarte rubrique={rubrique} />
				</div>
			))
		}
		{
			crepes && (
				<div class="encadre crepes">
					<RubriqueCarte rubrique={crepes} />
				</div>
			)
		}
	</div>

	<footer class="pied">
		<p>
			<strong>{site.nom}</strong> · {rue}, {codePostal} {ville}<br />
			<span class="mentions">{mentionsAlcool.join(' ')}</span>
		</p>
		<div class="qr">
			<p>Suivez-nous<br />sur Facebook&nbsp;!</p>
			<span class="qr-code" set:html={qr} />
		</div>
	</footer>
</FeuilleA4>

<style>
	:global(.creme) {
		display: flex;
		flex-direction: column;
		color: var(--brun);
		background: var(--creme);
	}

	:global(.creme) > :global(.filigrane) {
		position: absolute;
		z-index: -1;
		left: -30mm;
		bottom: 20mm;
		width: 130mm;
		color: var(--brun);
		opacity: 0.06;
	}

	/* Bandeau brun en haut, comme l'en-tête du site, avec le titre « La carte » à droite */
	.entete {
		display: flex;
		align-items: center;
		gap: 4mm;
		padding: 6mm 12mm;
		color: var(--creme);
		background: var(--brun);
		border-bottom: 2mm solid var(--vert);
	}

	.logo {
		flex: none;
		width: 22mm;
		height: 22mm;
		border-radius: 50%;
		background: var(--creme);
	}

	.nom-site {
		font-family: var(--font-titre);
		font-size: 9mm;
		line-height: 1;
	}

	.accroche-site {
		font-size: 4.5mm;
		font-weight: 700;
		font-style: italic;
		color: var(--vert);
	}

	h1 {
		margin: 0 0 0 auto;
		font-size: 15mm;
		line-height: 1;
		color: var(--vert);
		transform: rotate(-3deg);
	}

	.grille-carte {
		flex: 1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: 1fr 1fr auto;
		gap: 7mm 8mm;
		padding: 9mm 12mm 8mm;
	}

	.encadre {
		padding: 5mm 6mm;
		background: var(--blanc);
		border: 0.8mm solid var(--brun);
		border-radius: 4mm;
		box-shadow: 1.5mm 1.5mm 0 var(--vert);
	}

	/* Les crêpes : bandeau pleine largeur, ombre rose, articles côte à côte */
	.crepes {
		grid-column: 1 / -1;
		box-shadow: 1.5mm 1.5mm 0 var(--rose);
	}

	:global(.creme .crepes .rubrique) {
		display: grid;
		grid-template-columns: 62mm 1fr;
		align-items: center;
		column-gap: 8mm;
	}

	:global(.creme .crepes .titre-rubrique),
	:global(.creme .crepes .note-rubrique) {
		grid-column: 1;
	}

	:global(.creme .crepes .articles) {
		grid-column: 2;
		grid-row: 1 / span 2;
	}

	:global(.creme .crepes .note-rubrique) {
		margin: 2mm 0 0;
	}

	/* Titre de rubrique : pastille rose inclinée, comme sur les affiches */
	:global(.creme .titre-rubrique) {
		display: inline-flex;
		align-items: center;
		gap: 2mm;
		margin: -9mm 0 3mm -2mm;
		padding: 1.8mm 5mm 0.8mm;
		font-size: 6mm;
		color: var(--blanc);
		background: var(--rose);
		border: 0.6mm solid var(--brun);
		border-radius: 999px;
		transform: rotate(-2deg);
	}

	:global(.creme .crepes .titre-rubrique) {
		justify-self: start;
		margin: 0;
	}

	:global(.creme .icone) {
		font-size: 5mm;
		transform: translateY(-0.5mm);
	}

	:global(.creme .note-rubrique) {
		margin-bottom: 2mm;
		font-size: 3.8mm;
		font-style: italic;
		font-weight: 700;
		color: var(--rose-fonce);
	}

	:global(.creme .article) {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas:
			'nom points prix'
			'detail detail .';
		align-items: baseline;
		column-gap: 2mm;
		padding-block: 1.3mm;
		font-size: 5mm;
		line-height: 1.25;
	}

	:global(.creme .nom) {
		grid-area: nom;
		font-weight: 800;
	}

	:global(.creme .format) {
		margin-left: 1.5mm;
		font-size: 3.6mm;
		font-weight: 700;
		opacity: 0.65;
	}

	:global(.creme .points) {
		grid-area: points;
		border-bottom: 0.6mm dotted rgb(62 36 22 / 0.4);
	}

	:global(.creme .prix) {
		grid-area: prix;
		font-weight: 800;
		font-size: 5.8mm;
		color: var(--rose-fonce);
		white-space: nowrap;
	}

	:global(.creme .detail) {
		grid-area: detail;
		font-size: 3.8mm;
		font-style: italic;
		font-weight: 700;
		opacity: 0.75;
	}

	.pied {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 6mm;
		padding: 0 12mm 7mm;
		font-size: 4mm;
		line-height: 1.4;
	}

	.pied strong {
		font-family: var(--font-titre);
		font-weight: 400;
		font-size: 5mm;
		color: var(--rose-fonce);
	}

	.mentions {
		font-size: 3.2mm;
		font-style: italic;
		opacity: 0.75;
	}

	.qr {
		display: flex;
		flex: none;
		align-items: center;
		gap: 3mm;
		text-align: right;
		font-weight: 800;
	}

	.qr-code {
		display: block;
		width: 18mm;
		padding: 1.5mm;
		background: var(--blanc);
		border: 0.6mm solid var(--brun);
		border-radius: 1.5mm;
	}

	.qr-code :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
