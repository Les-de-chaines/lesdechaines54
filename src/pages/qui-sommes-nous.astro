---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';
import Embleme from '../components/Embleme.astro';
import { url } from '../lib/url';
import { site } from '../lib/site';

// Documents officiels : déposer les PDF dans public/documents/ avec ces noms de fichier.
// Tant qu'un fichier est absent, la page affiche « bientôt disponible ».
const documents = [
	{ titre: 'Statuts', fichier: 'statuts.pdf' },
	{ titre: 'Règlement intérieur', fichier: 'reglement-interieur.pdf' },
].map((doc) => ({ ...doc, disponible: fs.existsSync(`public/documents/${doc.fichier}`) }));

const bureau = [
	{
		embleme: '🍪',
		prenom: 'Cindy',
		titre: 'Fée des cookies',
		texte:
			"Point faible\u00a0: choisir. Le jeu, le personnage, et même le cookie, puisqu'elle en apporte trois fournées pour trouver la meilleure recette. Point fort\u00a0: un sac sans fond, où elle range les projets des autres en plus des siens. Elle apprend tout, partout, tout le temps… sauf les règles.",
	},
	{
		embleme: '🧚',
		prenom: 'Perrine',
		titre: 'Fée des crêpes',
		texte:
			"Quête principale\u00a0: finir un projet. Quêtes secondaires\u00a0: les 47 autres déjà commencés. Une tête pleine d'idées, des projets plein les bras et des armoires de jeux qui rêvent de prendre l'air. Elle dit oui aux défis les plus fous et aux crêpes à toute heure.",
	},
	{
		embleme: '🖌️',
		croise: true, // deux pinceaux croisés : l'emoji est doublé en miroir
		prenom: 'Nicolas',
		titre: "Pinceau de l'Empereur",
		texte:
			"Pinceau dans une main, liste d'armée dans l'autre, il mène ses troupes à la bataille contre ses potes jusqu'à pas d'heure, entre deux matchs de Blood Bowl. Le trésor de la guilde est entre de bonnes mains\u00a0: il compte aussi bien ses pièces d'or que ses points d'armée.",
	},
	{
		embleme: '💀',
		prenom: 'Christophe',
		titre: 'Nécron à manette',
		texte:
			"Némésis du Pinceau de l'Empereur, il affronte ses adversaires avec ses Nécrons\u00a0: immortels, mais jamais aidés par les dés. Gamer entre deux batailles, il a une arme secrète\u00a0: sa tchatche. Il vous convaincra de rejouer une partie avant que vous ayez fini de ranger.",
	},
];
---

<Layout titre="Qui sommes-nous" description={`Présentation de l'association ${site.nom} : son objet, son fonctionnement, ses statuts.`}>
	<div class="conteneur section">
		<h1>Qui <span class="insecable">sommes-nous&nbsp;?</span></h1>

		<div class="grille-page">
			<section class="carte guilde">
				<h2 class="titre-embleme"><Embleme />La guilde</h2>
				<ul class="quetes">
					<li><strong>Quête de départ&nbsp;:</strong> trouver un espace sans enfants pour se retrouver et jouer.</li>
					<li><strong>Quête secondaire&nbsp;:</strong> trouver de la place pour ranger les nouveaux jeux.</li>
					<li><strong>Résultat&nbsp;:</strong> impossible.</li>
					<li class="nouvelle-quete"><strong>Nouvelle quête&nbsp;:</strong> ouvrir un café jeux&nbsp;!</li>
				</ul>
				<h3>Les membres fondateurs</h3>
				<ul class="membres">
					{
						bureau.map(({ embleme, croise, prenom, titre, texte }) => (
							<li>
								<p class="embleme-membre" aria-hidden="true">
									{croise ? (
										<span class="croise"><span>{embleme}</span><span>{embleme}</span></span>
									) : (
										embleme
									)}
								</p>
								<p class="nom"><strong>{prenom}</strong></p>
								<p class="titre-membre">{titre}</p>
								<p>{texte}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="carte colonne">
				<h2 class="titre-embleme"><Embleme />Notre objet</h2>
				<p>Selon nos statuts, l'association a pour but de&nbsp;:</p>
				<ul class="a-completer">
					<li>[promouvoir la pratique des jeux de société et des jeux de figurines]</li>
					<li>[créer du lien social autour du jeu, pour tous les âges]</li>
					<li>[faire vivre un café associatif, lieu de rencontre et de convivialité]</li>
				</ul>
				<p class="documents">
					{
						documents.map(({ titre, fichier, disponible }, i) => (
							<>
								{i > 0 && ' · '}
								{disponible ? (
									<a href={url(`documents/${fichier}`)} target="_blank" rel="noopener">{titre} (PDF)&nbsp;↗</a>
								) : (
									<span>{titre} (bientôt disponible)</span>
								)}
							</>
						))
					}
				</p>
			</section>

			<section class="carte">
				<h2 class="titre-embleme"><Embleme />Notre fonctionnement</h2>
				<h3>Une association loi 1901</h3>
				<p>
					{site.nom} est une association à but non lucratif, animée par des bénévoles. Chaque euro récolté sert à
					faire vivre la taverne&nbsp;: jeux, matériel, événements.
				</p>
				<h3>Les adhérents</h3>
				<p>
					L'adhésion annuelle donne accès à toutes nos activités et permet de voter à l'assemblée générale. <a href={url('infos/')}>Voir les tarifs →</a>
				</p>
				<h3>Les bénévoles</h3>
				<p>
					Envie de tenir le comptoir, d'animer une partie ou d'organiser un tournoi&nbsp;? Toute aide est la bienvenue&nbsp;: <a href={`mailto:${site.email}`}>écrivez-nous</a>.
				</p>
			</section>
		</div>
	</div>
</Layout>

<style>
	/* La guilde (histoire + membres) sur toute la largeur, puis Notre objet et Notre fonctionnement côte à côte, à la même hauteur */
	.grille-page {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 48rem) {
		.grille-page {
			grid-template-columns: 1fr 1fr;
		}

		.guilde {
			grid-column: 1 / -1;
		}
	}

	.insecable {
		white-space: nowrap;
	}

	h3 {
		margin: 1.25rem 0 0.4rem;
	}

	ul.a-completer {
		padding-left: 1.2rem;
	}

	/* La quête fondatrice, façon journal de quêtes */
	.quetes {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.quetes li + li {
		margin-top: 0.5rem;
	}

	.nouvelle-quete {
		margin-top: 1rem !important;
		font-size: 1.1rem;
	}

	/* Les membres : une fiche chacun, 1 colonne sur mobile, 2 sur tablette, 4 sur grand écran */
	.guilde h3 {
		margin-top: 1.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(62 36 22 / 0.15);
	}

	.membres {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 40rem) {
		.membres {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 64rem) {
		.membres {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.membres li {
		text-align: center;
	}

	.membres p {
		margin: 0;
	}

	.embleme-membre {
		font-size: 2.25rem;
		line-height: 1;
		margin-bottom: 0.5rem !important;
	}

	.titre-membre {
		font-style: italic;
		margin-bottom: 0.6rem !important;
	}

	.membres li > p:last-child {
		text-align: left;
	}

	/* Emoji doublé et retourné pour former un X */
	.croise {
		position: relative;
		display: inline-block;
	}

	.croise > span + span {
		position: absolute;
		inset: 0;
		transform: scaleX(-1);
	}

	/* Notre objet : les documents officiels calés en bas de la carte */
	.colonne {
		display: flex;
		flex-direction: column;
	}

	.documents {
		margin: auto 0 0;
		padding-top: 1rem;
		border-top: 1px solid rgb(62 36 22 / 0.15);
		font-size: 0.85rem;
	}

	.colonne > ul {
		margin-bottom: 1.75rem;
	}

	.documents span {
		font-style: italic;
		opacity: 0.7;
	}
</style>
