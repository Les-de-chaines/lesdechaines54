---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url } from '../lib/url';
import { site } from '../lib/site';
import Reseaux from './Reseaux.astro';

const liens = [
	{ href: url(), label: 'Accueil' },
	{ href: url('qui-sommes-nous/'), label: 'Qui sommes-nous' },
	{ href: url('evenements/'), label: 'Événements' },
	{ href: url('infos/'), label: 'Infos pratiques' },
];

const actuel = Astro.url.pathname.replace(/\/?$/, '/');

// Sur tout petit écran, le nom passe sur deux lignes : on coupe après « Les », jamais sur le trait d'union
const [premierMot, ...suite] = site.nom.split(' ');
---

<header>
	<div class="conteneur barre">
		<a href={url()} class="marque">
			<Image src={logo} alt="" width={64} height={64} loading="eager" />
			<span class="textes">
				<span class="nom">{premierMot} <span class="insecable">{suite.join(' ')}</span></span>
				<span class="accroche">{site.accroche}</span>
			</span>
		</a>
		<!-- Bouton du menu mobile : caché tant que le script ne l'a pas activé (sans JavaScript, le menu reste déplié) -->
		<button type="button" class="burger" aria-expanded="false" aria-controls="menu" hidden>
			<span class="barres" aria-hidden="true"><span></span></span>
			<span class="libelle">Menu</span>
		</button>
		<nav id="menu" aria-label="Menu principal">
			{
				liens.map(({ href, label }) => (
					<a href={href} aria-current={href === actuel ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>
		<span class="reseaux-menu"><Reseaux variante="icones" /></span>
	</div>
</header>

<script>
	const bouton = document.querySelector<HTMLButtonElement>('.burger');
	if (bouton) {
		bouton.hidden = false;
		const basculer = (ouvert: boolean) => bouton.setAttribute('aria-expanded', String(ouvert));
		bouton.addEventListener('click', () => basculer(bouton.getAttribute('aria-expanded') !== 'true'));
		// Échap referme le menu et rend la main au bouton
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') {
				basculer(false);
				bouton.focus();
			}
		});
	}
</script>

<style>
	header {
		background: var(--brun);
		border-bottom: 5px solid var(--vert);
	}

	.barre {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		padding-block: 0.5rem;
	}

	.marque {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		font-family: var(--font-titre);
		font-size: 1.6rem;
		color: var(--creme);
	}

	.textes {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}

	.nom,
	.insecable {
		white-space: nowrap;
	}

	.accroche {
		font-family: var(--font-texte);
		font-size: 0.85rem;
		font-weight: 700;
		font-style: italic;
		color: var(--vert);
	}

	.marque img {
		border-radius: 50%;
		background: var(--creme);
	}

	/* Sur grand écran : logo à gauche, puis menu et réseaux poussés à droite */
	nav {
		margin-left: auto;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	nav a {
		color: var(--creme);
		text-decoration: none;
		font-weight: 800;
		padding-block: 0.25rem;
		border-bottom: 3px solid transparent;
	}

	nav a:hover {
		border-bottom-color: var(--vert);
	}

	/* Les icônes ne prennent pas le soulignement vert des liens du menu */
	.reseaux-menu {
		display: flex;
		align-items: center;
		padding-left: 1.5rem;
		color: var(--creme);
		border-left: 2px solid rgb(251 246 234 / 0.25);
	}

	.reseaux-menu :global(a) {
		border-bottom: none;
	}

	/* Trait plus fin que la version du pied de page */
	.reseaux-menu :global(svg) {
		stroke-width: 1.5;
	}

	.reseaux-menu :global(a:hover) {
		color: var(--vert);
	}

	nav a[aria-current='page'] {
		color: var(--vert);
		border-bottom-color: var(--vert);
	}

	/* Bouton burger : trois barres qui se changent en croix quand le menu est ouvert */
	.burger {
		display: none;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		color: var(--creme);
		background: none;
		border: 2px solid var(--creme);
		border-radius: 50%;
		cursor: pointer;
	}

	/* Le mot « Menu » est masqué à l'écran mais lu par les lecteurs d'écran */
	.libelle {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.burger:hover,
	.burger[aria-expanded='true'] {
		color: var(--vert);
		border-color: var(--vert);
	}

	.barres,
	.barres::before,
	.barres::after,
	.barres span {
		display: block;
		width: 1.1rem;
		height: 2px;
		background: currentColor;
		border-radius: 2px;
		transition: transform 0.2s, opacity 0.2s;
	}

	.barres {
		position: relative;
		background: none;
	}

	.barres::before,
	.barres::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.barres::before {
		top: -6px;
	}

	.barres::after {
		top: 6px;
	}

	[aria-expanded='true'] .barres span {
		opacity: 0;
	}

	[aria-expanded='true'] .barres::before {
		transform: translateY(6px) rotate(45deg);
	}

	[aria-expanded='true'] .barres::after {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* Sur mobile et tablette (le menu complet ne tient pas sur une ligne) : logo, icônes des réseaux (toujours visibles) et bouton sur une ligne ;
	   les liens se replient derrière le bouton et se déplient en liste, un lien par ligne */
	@media (max-width: 59.99rem) {
		.barre {
			column-gap: 0.75rem;
		}

		/* Le logo prend la place restante ; le slogan peut passer sur deux lignes */
		.marque {
			flex: 1 1 0;
			min-width: 0;
			gap: 0.5rem;
			font-size: 1.25rem;
		}

		.marque img {
			flex: none;
			width: 2.75rem;
			height: 2.75rem;
		}

		.accroche {
			font-size: 0.75rem;
		}

		/* Ordre à l'écran : logo, réseaux, bouton, puis les liens dépliés */
		.reseaux-menu {
			order: 1;
			padding-left: 0;
			border-left: none;
		}

		.reseaux-menu :global(svg) {
			width: 1.3rem;
			height: 1.3rem;
		}

		.burger:not([hidden]) {
			display: inline-flex;
			order: 2;
		}

		.burger:not([hidden]) + nav {
			display: none;
		}

		.burger[aria-expanded='true'] + nav {
			display: flex;
		}

		nav {
			order: 3;
			margin-left: 0;
			flex-direction: column;
			flex-basis: 100%;
			gap: 0;
			padding-bottom: 0.5rem;
		}

		nav a {
			padding-block: 0.75rem;
			border-bottom: 1px solid rgb(251 246 234 / 0.15);
		}

		nav a:last-child {
			border-bottom: none;
		}

		nav a[aria-current='page'] {
			border-bottom-color: rgb(251 246 234 / 0.15);
		}

		nav a[aria-current='page']::before {
			content: '▸ ';
		}
	}

	/* Très petits écrans : tout est un peu resserré, et le nom peut passer sur deux lignes en dernier recours */
	@media (max-width: 23rem) {
		.nom {
			white-space: normal;
		}

		.barre {
			column-gap: 0.5rem;
		}

		.marque {
			font-size: 1.05rem;
		}

		.marque img {
			width: 2rem;
			height: 2rem;
		}

		.burger {
			width: 2.4rem;
			height: 2.4rem;
		}

		.reseaux-menu :global(ul) {
			gap: 0.5rem;
		}
	}
</style>
