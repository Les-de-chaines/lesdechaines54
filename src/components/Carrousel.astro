---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Toutes les images du dossier src/assets/carrousel/, triées par nom de fichier.
// Le texte alternatif est tiré du nom : "02-atelier-peinture.jpg" → "atelier peinture".
const fichiers = import.meta.glob<{ default: ImageMetadata }>('../assets/carrousel/*.{jpg,jpeg,png,webp,avif}', {
	eager: true,
});

const photos = Object.entries(fichiers)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([chemin, module]) => ({
		src: module.default,
		alt: chemin
			.split('/')
			.pop()!
			.replace(/\.[^.]+$/, '')
			.replace(/^\d+[-_ ]*/, '')
			.replace(/[-_]+/g, ' '),
	}));
---

{
	photos.length > 0 && (
		<section class="carrousel" aria-roledescription="carrousel" aria-label="Photos de l'association">
			<div class="piste" tabindex="0">
				{photos.map((photo, i) => (
					<figure class="diapo" aria-roledescription="diapositive" aria-label={`${i + 1} sur ${photos.length}`}>
						<Image
							src={photo.src}
							alt={photo.alt}
							widths={[640, 960, 1280, 1600]}
							sizes="(min-width: 70rem) 68rem, 100vw"
							loading={i === 0 ? 'eager' : 'lazy'}
						/>
					</figure>
				))}
			</div>

			{photos.length > 1 && (
				<>
					<button class="fleche precedent" type="button" aria-label="Photo précédente">‹</button>
					<button class="fleche suivant" type="button" aria-label="Photo suivante">›</button>
					<div class="points">
						{photos.map((_, i) => (
							<button type="button" aria-label={`Aller à la photo ${i + 1}`} data-index={i} />
						))}
					</div>
				</>
			)}
		</section>
	)
}

<script>
	const DELAI = 5000; // millisecondes entre deux photos

	document.querySelectorAll<HTMLElement>('.carrousel').forEach((carrousel) => {
		const piste = carrousel.querySelector<HTMLElement>('.piste')!;
		const diapos = [...piste.children] as HTMLElement[];
		const points = [...carrousel.querySelectorAll<HTMLButtonElement>('.points button')];
		if (diapos.length < 2) return;

		const actuelle = () => Math.round(piste.scrollLeft / piste.clientWidth);
		const allerA = (i: number) => {
			const cible = (i + diapos.length) % diapos.length;
			piste.scrollTo({ left: cible * piste.clientWidth, behavior: 'smooth' });
		};

		const majPoints = () => {
			const i = actuelle();
			points.forEach((p, j) => p.setAttribute('aria-current', String(i === j)));
		};
		piste.addEventListener('scroll', majPoints, { passive: true });
		majPoints();

		carrousel.querySelector('.precedent')!.addEventListener('click', () => allerA(actuelle() - 1));
		carrousel.querySelector('.suivant')!.addEventListener('click', () => allerA(actuelle() + 1));
		points.forEach((p) => p.addEventListener('click', () => allerA(Number(p.dataset.index))));

		// Défilement automatique, en pause au survol ou au focus, désactivé si l'utilisateur limite les animations
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		let minuteur: number | undefined;
		const demarrer = () => {
			arreter();
			minuteur = window.setInterval(() => allerA(actuelle() + 1), DELAI);
		};
		const arreter = () => window.clearInterval(minuteur);
		carrousel.addEventListener('mouseenter', arreter);
		carrousel.addEventListener('mouseleave', demarrer);
		carrousel.addEventListener('focusin', arreter);
		carrousel.addEventListener('focusout', demarrer);
		demarrer();
	});
</script>

<style>
	.carrousel {
		position: relative;
		width: 100%;
		max-width: var(--largeur);
		margin-inline: auto;
		padding-inline: 1rem;
	}

	/* La piste fait exactement 16/9 hors bordure : une photo 16/9 s'affiche en entier.
	   Une photo d'un autre format n'est jamais rognée, elle est bordée de bandes brunes. */

	.piste {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		aspect-ratio: 16 / 9;
		box-sizing: content-box;
		width: calc(100% - 6px); /* moins la bordure, pour rester aligné sur le reste de la page */
		border: 3px solid var(--brun);
		border-radius: var(--rayon);
		box-shadow: 6px 6px 0 var(--vert);
		background: var(--brun);
	}

	.piste::-webkit-scrollbar {
		display: none;
	}

	.diapo {
		flex: 0 0 100%;
		margin: 0;
		scroll-snap-align: start;
	}

	.diapo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.fleche {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
		width: 2.75rem;
		height: 2.75rem;
		display: grid;
		place-items: center;
		font-size: 2rem;
		line-height: 1;
		padding-bottom: 0.2rem;
		color: var(--brun);
		background: var(--creme);
		border: 3px solid var(--brun);
		border-radius: 50%;
		box-shadow: 2px 2px 0 var(--brun);
		cursor: pointer;
	}

	.fleche:hover {
		color: var(--blanc);
		background: var(--rose);
	}

	.precedent {
		left: 1.75rem;
	}

	.suivant {
		right: 1.75rem;
	}

	.points {
		display: flex;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 1rem;
	}

	.points button {
		width: 0.85rem;
		height: 0.85rem;
		padding: 0;
		border: 2px solid var(--brun);
		border-radius: 50%;
		background: var(--blanc);
		cursor: pointer;
	}

	.points button[aria-current='true'] {
		background: var(--rose);
	}
</style>
