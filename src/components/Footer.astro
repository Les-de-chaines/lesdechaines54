---
import { url } from '../lib/url';
import { site } from '../lib/site';

const reseaux = Object.entries(site.reseaux).filter(([, lien]) => lien);
---

<footer>
	<div class="conteneur grille">
		<div>
			<p class="nom">{site.nom}</p>
			<p>Association loi 1901<br />{site.slogan}</p>
		</div>
		<div>
			<p class="titre">Nous trouver</p>
			<p>
				{site.adresse.rue}<br />
				{site.adresse.codePostal} {site.adresse.ville}
			</p>
			<p><a href={url('infos/')}>Infos pratiques</a></p>
		</div>
		<div>
			<p class="titre">Contact</p>
			<p><a href={`mailto:${site.email}`}>{site.email}</a></p>
			{
				reseaux.length > 0 && (
					<p>
						{reseaux.map(([nom, lien]) => (
							<a href={lien} class="reseau">
								{nom}
							</a>
						))}
					</p>
				)
			}
		</div>
	</div>
	<p class="conteneur legal">
		<a href={url('mentions-legales/')}>Mentions légales</a> · <a href={url('confidentialite/')}>Confidentialité &amp; cookies</a> · <button type="button" class="gerer-cookies">Gérer les cookies</button>
	</p>
</footer>

<script>
	import { ouvrirFenetre } from '../lib/consentement';

	document.querySelector('.gerer-cookies')?.addEventListener('click', ouvrirFenetre);
</script>

<style>
	footer {
		background: var(--brun);
		color: var(--creme);
		border-top: 5px solid var(--vert);
		padding-block: 2rem 1rem;
		font-size: 0.95rem;
	}

	p {
		margin: 0 0 0.5rem;
	}

	.nom {
		font-family: var(--font-titre);
		font-size: 1.5rem;
	}

	.titre {
		font-weight: 800;
		color: var(--vert);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	a {
		color: var(--creme);
	}

	.legal {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(251 246 234 / 0.2);
		font-size: 0.85rem;
	}

	.gerer-cookies {
		padding: 0;
		font: inherit;
		color: var(--creme);
		text-decoration: underline;
		background: none;
		border: 0;
		cursor: pointer;
	}

	.reseau {
		margin-right: 1rem;
		text-transform: capitalize;
	}
</style>
