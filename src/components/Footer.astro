---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url } from '../lib/url';
import { site } from '../lib/site';
import Embleme from './Embleme.astro';
import Reseaux from './Reseaux.astro';
---

<footer class="avec-filigrane">
	<Embleme class="filigrane" />
	<div class="conteneur grille">
		<div>
			<p class="marque">
				<Image src={logo} alt="" width={160} height={160} />
				<span class="nom">{site.nom}</span>
			</p>
			<p>Association loi 1901<br />{site.slogan}</p>
		</div>
		<div>
			<p class="titre">Nous trouver</p>
			<p>
				{site.adresse.rue}<br />
				{site.adresse.codePostal} {site.adresse.ville}
			</p>
			<p><a href={url('infos/')}>Infos pratiques</a></p>
		</div>
		<div>
			<p class="titre">Contact</p>
			<p>
				{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span class="bientot">E-mail bientôt disponible</span>}
			</p>
			<p class="titre suivre">Suivez-nous</p>
			<Reseaux variante="discret" />
		</div>
	</div>
	<p class="conteneur legal">
		<a href={url('mentions-legales/')}>Mentions légales</a> · <a href={url('confidentialite/')}>Confidentialité &amp; cookies</a>
	</p>
</footer>

<style>
	footer {
		background: var(--brun);
		color: var(--creme);
		border-top: 5px solid var(--vert);
		padding-block: 2rem 1rem;
		font-size: 0.95rem;
	}

	p {
		margin: 0 0 0.5rem;
	}

	/* Logo rond sur fond crème, comme dans l'en-tête, avec le nom à côté */
	.marque {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.marque img {
		flex: none;
		width: 5rem;
		height: 5rem;
		border-radius: 50%;
		background: var(--creme);
	}

	.nom {
		font-family: var(--font-titre);
		font-size: 1.5rem;
	}

	.titre {
		font-weight: 800;
		color: var(--vert);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	a {
		color: var(--creme);
	}

	.legal {
		margin: 1.5rem auto 0;
		padding-top: 1rem;
		border-top: 1px solid rgb(251 246 234 / 0.2);
		font-size: 0.85rem;
	}

	.suivre {
		margin-top: 1rem;
	}
</style>
