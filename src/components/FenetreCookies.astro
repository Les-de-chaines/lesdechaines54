---
// Bandeau discret en bas de page, affiché à la première visite pour accepter ou refuser les cookies tiers.
import { url } from '../lib/url';
---

<div class="fenetre-cookies" role="region" aria-label="Choix des cookies" hidden>
	<p>
		🍪 Seule la carte Google Maps de ce site utilise des cookies. <a href={url('confidentialite/')}>En savoir plus</a>
	</p>
	<div class="choix">
		<button type="button" data-choix="refuse">Refuser</button>
		<button type="button" data-choix="accepte">Accepter</button>
	</div>
</div>

<script>
	import { enregistrerChoix, lireChoix, type Choix } from '../lib/consentement';

	const fenetre = document.querySelector<HTMLElement>('.fenetre-cookies')!;
	const afficher = () => (fenetre.hidden = false);

	fenetre.querySelectorAll<HTMLButtonElement>('[data-choix]').forEach((bouton) =>
		bouton.addEventListener('click', () => {
			enregistrerChoix(bouton.dataset.choix as Choix);
			fenetre.hidden = true;
		}),
	);

	// Bandeau non bloquant : le visiteur peut naviguer sans choisir (la carte reste alors masquée)
	document.addEventListener('consentement-ouvrir', afficher);
	if (lireChoix() === null) afficher();
</script>

<style>
	.fenetre-cookies {
		position: fixed;
		inset: auto 0 0;
		z-index: 100;
		padding: 0.75rem 1rem;
		color: var(--creme);
		background: var(--brun);
		border-top: 2px solid var(--vert);
		font-size: 0.9rem;
	}

	.fenetre-cookies:not([hidden]) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 1.5rem;
	}

	p {
		margin: 0;
	}

	a {
		color: var(--creme);
		white-space: nowrap;
	}

	.choix {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	/* Même apparence pour les deux choix : refuser doit être aussi simple qu'accepter (recommandation CNIL) */
	button {
		padding: 0.2rem 0.25rem;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--creme);
		text-decoration: underline;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	button:hover {
		color: var(--vert);
	}
</style>
